{
  "name": "@yangzhe1991/dsh-proxy-router",
  "version": "0.1.0",
  "description": "DSH 插件:本地分流代理 + Web 设置页 —— 只有规则命中的被墙域名走上游代理,其余(国内/内网/未知)直连;上游地址、清单、超时等参数直接在设置里改,热生效、免重启,并带运行状态面板 | DSH plugin: local routing proxy with a Web settings page — only rule-matched (blocked) hosts use the upstream proxy, everything else goes direct; the upstream address, blocklists, timeouts and more are edited in Settings and applied live, with a built-in status panel",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.zh.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yangzhe1991/dsh-proxy-router.git"
  },
  "homepage": "https://github.com/yangzhe1991/dsh-proxy-router",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "proxy",
    "gfw",
    "routing"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node test/run.mjs",
    "typecheck": "tsc --noEmit",
    "prepare": "node build.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/cordis",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.31",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT"
}
